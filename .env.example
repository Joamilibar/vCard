# Copia este archivo como .env y ajusta los valores.

# Puerto del servidor web
PORT=3000

# Cadena de conexión a MongoDB.
# - En Docker Compose usa el nombre del servicio: mongodb://mongo:27017/vcards
# - En local (mongo en tu máquina): mongodb://127.0.0.1:27017/vcards
MONGO_URI=mongodb://mongo:27017/vcards

# --- Auth0 ---------------------------------------------------------------
# Datos del panel de Auth0 (no son secretos; el frontend los usa vía /api/config).
#
# AUTH0_DOMAIN   : el dominio de tu tenant, p. ej. dev-abc123.us.auth0.com
# AUTH0_CLIENT_ID: el Client ID de la aplicación SPA "vCard SPA".
# AUTH0_AUDIENCE : el Identifier de la API que creaste, p. ej. https://vcard-api
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_CLIENT_ID=tu_client_id
AUTH0_AUDIENCE=https://vcard-api
