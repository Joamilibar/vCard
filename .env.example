# Copia este archivo como .env y ajusta los valores.

# Puerto del servidor web
PORT=3000

# Cadena de conexión a MongoDB.
# - En Docker Compose usa el nombre del servicio: mongodb://mongo:27017/vcards
# - En local (mongo en tu máquina): mongodb://127.0.0.1:27017/vcards
MONGO_URI=mongodb://mongo:27017/vcards

# Secreto para firmar los tokens JWT. Cámbialo por una cadena larga y aleatoria.
JWT_SECRET=cambia-este-secreto-en-produccion
